cc_library_static {
    name: "libfbjni",
    export_include_dirs: ["cxx"],
    srcs: [
        "cxx/fbjni/*.cpp",
        "cxx/fbjni/detail/*.cpp",
        "cxx/lyra/*.cpp",
    ],
    sdk_version: "current",
    min_sdk_version: "apex_inherit",
    stl: "libc++_static",
    cflags: [
        "-fexceptions",
        "-frtti",
    ],
    rtti: true,
    visibility: [
        "//external/executorch:__subpackages__",
        "//packages/modules/OnDevicePersonalization/apex",
    ],
    header_libs: [
        "jni_headers",
    ],
    shared_libs: [
        "liblog",
    ],
    apex_available: ["com.android.ondevicepersonalization"],
}

java_library {
    name: "libfbjni_java",
    sdk_version: "current",
    min_sdk_version: "33",
    srcs: [
        "java/com/facebook/jni/annotations/*.java",
        "java/com/facebook/jni/*.java",
    ],
    static_libs: [
        "jsr305",
    ],
    apex_available: [
        "com.android.ondevicepersonalization",
    ],
}
